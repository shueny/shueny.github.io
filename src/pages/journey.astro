---
import MainLayout from "@/layouts/main-layout.astro";
import LifeGlobeIsland from "@/components/globe/LifeGlobeIsland";

export const prerender = true;
---

<MainLayout
  title="我的人生旅程 · 3D 地球儀"
  description="以互動式 3D 地球儀呈現 Shueny 的人生旅程:從台北的學生時期、成為資深前端工程師,到走遍世界各地的足跡,點選年份即可飛往當年的所在地。"
>
  <!-- Fetch textures in parallel with the JS bundle instead of after it.
       (Body-level preload links are honored by browsers; the layout has no head slot.) -->
  <link rel="preload" as="image" href="/images/globe/earth-blue-marble.jpg" />
  <link rel="preload" as="image" href="/images/globe/night-sky.jpg" />

  <section
    class="relative w-full overflow-hidden bg-[#03060f] h-[calc(100svh-2.75rem)] md:h-[calc(100svh-3rem)]"
    aria-label="3D 地球儀人生旅程"
  >
    <LifeGlobeIsland client:only="react" />
  </section>
</MainLayout>
