---
/**
 * HeroStatic.astro - Pure Astro static Hero component
 * 
 * Renders as raw HTML in the initial page load (no JS needed for FCP).
 * Language switching is handled by a tiny inline script that listens
 * to the 'languagechange' custom event dispatched by the Navbar island.
 */
import { SectionId } from '../types';
import HeroThreeIsland from './islands/HeroThreeIsland';

// All hero translations embedded directly
const heroI18n = {
  EN: {
    location: 'Based in Germany (CET) | Available for Hybrid (Ulm) & Global Remote',
    locationMobile: 'Germany (CET) | Hybrid & Remote',
    title1: 'Senior Frontend Engineer',
    title2: 'Shueny Wang',
    title3: 'AI Solutions',
    title3Suffix: 'Builder',
    subtitle: 'Frontend architecture that scales. AI features that ship.',
    description: 'Nine years of React and TypeScript across automotive cybersecurity, B2B SaaS, and e-commerce, including three and a half years at VicOne (Trend Micro) as sole frontend engineer. Since 2025, independent: lead frontend on enterprise platforms, and LLM products shipped end to end — RAG pipelines, agent workflows, and interfaces people trust.',
    ctaPrimary: 'View Projects',
    ctaSecondary: 'Download Resume',
    scroll: 'Scroll',
  },
  DE: {
    location: 'Ansässig in Deutschland (MEZ) | Verfügbar für Hybrid (Ulm) & Global Remote',
    locationMobile: 'Deutschland (MEZ) | Hybrid & Remote',
    title1: 'Senior Frontend',
    title2: 'Engineer &',
    title3: 'KI-Lösungen',
    title3Suffix: 'Builder',
    subtitle: 'Frontend-Architektur, die skaliert. KI-Features, die live gehen.',
    description: 'Neun Jahre React und TypeScript in Automotive-Cybersecurity, B2B-SaaS und E-Commerce, davon dreieinhalb Jahre bei VicOne (Trend Micro) als alleiniger Frontend-Engineer. Seit 2025 selbstständig: leitender Frontend-Engineer für Enterprise-Plattformen und LLM-Produkte von A bis Z — RAG-Pipelines, Agent-Workflows und Interfaces, denen Menschen vertrauen.',
    ctaPrimary: 'Projekte ansehen',
    ctaSecondary: 'Lebenslauf herunterladen',
    scroll: 'Scrollen',
  },
  ZH: {
    location: '位於德國（中歐時區）| 可進行混合辦公（烏爾姆）與全球遠程合作',
    locationMobile: '德國（中歐時區）| 混合辦公與遠程',
    title1: '資深前端',
    title2: '工程師 &',
    title3: 'AI 解決方案',
    title3Suffix: '實踐者',
    subtitle: '可擴展的前端架構。能真正上線的 AI 功能。',
    description: '九年 React 與 TypeScript 經驗，橫跨汽車網路安全、B2B SaaS 與電商，其中三年半在 VicOne（趨勢科技）以唯一前端工程師的身分打造安全平台。2025 年起獨立接案：擔任企業平台的前端主導，同時把 LLM 產品從頭做到上線——RAG pipeline、agent 工作流程，以及讓人信任的介面。',
    ctaPrimary: '查看專案',
    ctaSecondary: '下載履歷',
    scroll: '向下滾動',
  },
};

const t = heroI18n.EN; // Default language for SSG
---

<section
  id={SectionId.HERO}
  class="min-h-screen flex flex-col justify-center relative overflow-hidden bg-surface pt-24 pb-32 md:pb-12 snap-center"
>
  <!-- Abstract Background Shapes -->
  <div class="absolute top-[-20%] right-[-10%] w-[70vw] h-[70vw] rounded-full border border-orange-200/40 opacity-60 animate-pulse-slow pointer-events-none"></div>
  <div class="absolute top-[20%] left-[-10%] w-[30vw] h-[30vw] rounded-full bg-orange-100/30 blur-3xl pointer-events-none"></div>

  <!-- three.js particle-wave accent (lazy, desktop only, reduced-motion aware) -->
  <HeroThreeIsland client:idle />

  <div class="container mx-auto px-6 md:px-12 relative z-10 h-full flex flex-col justify-center">
    <!-- Intro Tag -->
    <div
      class="flex items-center gap-2 sm:gap-4 mb-6 sm:mb-8 md:mb-10 animate-fade-in-up"
      style="animation-delay: 0s"
    >
      <span class="relative flex h-2.5 w-2.5 sm:h-3 sm:w-3 flex-shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 sm:h-3 sm:w-3 bg-accent"></span>
      </span>
      <span
        class="uppercase tracking-widest text-[9px] sm:text-[10px] md:text-xs font-bold leading-tight"
        style="color: hsl(var(--accent))"
      >
        <span class="hidden sm:inline" data-i18n="hero.location">{t.location}</span>
        <span class="inline sm:hidden" data-i18n="hero.locationMobile">{t.locationMobile}</span>
      </span>
    </div>

    <!-- Macro Typography -->
    <div class="relative mb-8 sm:mb-10 md:mb-12">
      <h1 class="text-[11vw] sm:text-[9vw] md:text-[7vw] lg:text-[6vw] leading-[0.95] sm:leading-[0.9] font-bold text-primary tracking-tighter font-sans mix-blend-multiply">
        <span
          class="block animate-fade-in-up font-extrabold"
          style="animation-delay: 0.15s"
          data-i18n="hero.title1"
        >
          {t.title1}
        </span>
        <span
          class="block text-transparent bg-clip-text bg-gradient-to-r from-stone-500 via-stone-400 to-stone-500 animate-fade-in-up font-bold mt-1 sm:mt-2"
          style="animation-delay: 0.3s"
          data-i18n="hero.title2"
        >
          {t.title2}
        </span>
        <span
          class="block animate-fade-in-up font-extrabold mt-1 sm:mt-2"
          style="animation-delay: 0.45s; color: hsl(var(--accent))"
        >
          <span data-i18n="hero.title3">{t.title3}</span>{' '}
          <span class="font-serif italic font-normal text-primary" data-i18n="hero.title3Suffix">
            {t.title3Suffix}
          </span>
        </span>
      </h1>
    </div>

    <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-6 sm:gap-8 md:gap-12 border-t border-orange-200/60 pt-8 sm:pt-10 md:pt-12">
      <!-- Quote section -->
      <div
        class="w-full md:w-1/2 animate-fade-in-up"
        style="animation-delay: 0.6s"
      >
        <p class="text-base sm:text-lg md:text-xl lg:text-2xl text-secondary font-sans leading-relaxed font-normal" data-i18n="hero.subtitle">
          {t.subtitle}
        </p>
      </div>

      <!-- CTA section -->
      <div
        class="w-full md:w-1/3 space-y-6 sm:space-y-8 animate-fade-in-up"
        style="animation-delay: 0.75s"
      >
        <p class="text-xs sm:text-sm md:text-base text-secondary leading-6 sm:leading-7 md:leading-8 font-light" data-i18n="hero.description">
          {t.description}
        </p>

        <div class="flex flex-col sm:flex-row md:flex-col xl:flex-row gap-3 sm:gap-4 w-full">
          <!-- Primary CTA -->
          <a
            href={`#${SectionId.PROJECTS}`}
            class="group relative w-full sm:w-auto md:w-full xl:w-auto px-6 sm:px-8 py-3.5 sm:py-4 text-white text-xs sm:text-sm font-bold uppercase tracking-wider overflow-hidden shadow-lg shadow-orange-500/30 rounded-full text-center flex justify-center items-center transition-all duration-300 hover:shadow-xl hover:shadow-orange-500/40 hover:scale-105"
            style="background-color: hsl(var(--accent))"
          >
            <span class="relative z-10 group-hover:text-white transition-colors duration-300" data-i18n="hero.ctaPrimary">
              {t.ctaPrimary}
            </span>
            <div class="absolute inset-0 bg-stone-900 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 ease-out origin-left"></div>
          </a>

          <!-- Secondary CTA -->
          <a
            href="/files/2026-08_Resume_ShuenyWang_ProductFullstack.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto md:w-full xl:w-auto px-6 sm:px-8 py-3.5 sm:py-4 border-2 border-stone-300 text-primary text-xs sm:text-sm font-bold uppercase tracking-wider hover:border-accent hover:text-accent hover:bg-accent/5 transition-all duration-300 rounded-full text-center flex justify-center items-center bg-white hover:scale-105"
            data-i18n="hero.ctaSecondary"
          >
            {t.ctaSecondary}
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 items-center animate-float opacity-60 hidden md:flex flex-col">
    <span
      class="text-[10px] uppercase tracking-widest mb-2 font-bold"
      style="color: hsl(var(--accent))"
      data-i18n="hero.scroll"
    >
      {t.scroll}
    </span>
    <div class="w-[1px] h-16 bg-gradient-to-b from-accent to-transparent"></div>
  </div>
</section>

<!-- Tiny inline script for language switching (< 1KB) -->
<script is:inline>
(function() {
  var heroI18n = {
    EN: {
      'hero.location': 'Based in Germany (CET) | Available for Hybrid (Ulm) & Global Remote',
      'hero.locationMobile': 'Germany (CET) | Hybrid & Remote',
      'hero.title1': 'Senior Frontend Engineer',
      'hero.title2': 'Shueny Wang',
      'hero.title3': 'AI Solutions',
      'hero.title3Suffix': 'Builder',
      'hero.subtitle': 'Frontend architecture that scales. AI features that ship.',
      'hero.description': 'Nine years of React and TypeScript across automotive cybersecurity, B2B SaaS, and e-commerce, including three and a half years at VicOne (Trend Micro) as sole frontend engineer. Since 2025, independent: lead frontend on enterprise platforms, and LLM products shipped end to end — RAG pipelines, agent workflows, and interfaces people trust.',
      'hero.ctaPrimary': 'View Projects',
      'hero.ctaSecondary': 'Download Resume',
      'hero.scroll': 'Scroll'
    },
    DE: {
      'hero.location': 'Ansässig in Deutschland (MEZ) | Verfügbar für Hybrid (Ulm) & Global Remote',
      'hero.locationMobile': 'Deutschland (MEZ) | Hybrid & Remote',
      'hero.title1': 'Senior Frontend',
      'hero.title2': 'Engineer &',
      'hero.title3': 'KI-Lösungen',
      'hero.title3Suffix': 'Builder',
      'hero.subtitle': 'Frontend-Architektur, die skaliert. KI-Features, die live gehen.',
      'hero.description': 'Neun Jahre React und TypeScript in Automotive-Cybersecurity, B2B-SaaS und E-Commerce, davon dreieinhalb Jahre bei VicOne (Trend Micro) als alleiniger Frontend-Engineer. Seit 2025 selbstständig: leitender Frontend-Engineer für Enterprise-Plattformen und LLM-Produkte von A bis Z — RAG-Pipelines, Agent-Workflows und Interfaces, denen Menschen vertrauen.',
      'hero.ctaPrimary': 'Projekte ansehen',
      'hero.ctaSecondary': 'Lebenslauf herunterladen',
      'hero.scroll': 'Scrollen'
    },
    ZH: {
      'hero.location': '位於德國（中歐時區）| 可進行混合辦公（烏爾姆）與全球遠程合作',
      'hero.locationMobile': '德國（中歐時區）| 混合辦公與遠程',
      'hero.title1': '資深前端',
      'hero.title2': '工程師 &',
      'hero.title3': 'AI 解決方案',
      'hero.title3Suffix': '實踐者',
      'hero.subtitle': '可擴展的前端架構。能真正上線的 AI 功能。',
      'hero.description': '九年 React 與 TypeScript 經驗，橫跨汽車網路安全、B2B SaaS 與電商，其中三年半在 VicOne（趨勢科技）以唯一前端工程師的身分打造安全平台。2025 年起獨立接案：擔任企業平台的前端主導，同時把 LLM 產品從頭做到上線——RAG pipeline、agent 工作流程，以及讓人信任的介面。',
      'hero.ctaPrimary': '查看專案',
      'hero.ctaSecondary': '下載履歷',
      'hero.scroll': '向下滾動'
    }
  };

  function updateHeroLang(lang) {
    var t = heroI18n[lang];
    if (!t) return;
    var els = document.querySelectorAll('[data-i18n]');
    for (var i = 0; i < els.length; i++) {
      var key = els[i].getAttribute('data-i18n');
      if (t[key] !== undefined) {
        els[i].textContent = t[key];
      }
    }
  }

  // Listen to language change events from Navbar island
  window.addEventListener('languagechange', function(e) {
    if (e.detail) updateHeroLang(e.detail);
  });

  // Check localStorage on load in case user previously selected a language
  var saved = localStorage.getItem('language');
  if (saved && heroI18n[saved]) updateHeroLang(saved);
})();
</script>
