---
import BaseLayout from '../layouts/BaseLayout.astro'
import { siteConfig } from '@/config/site'
import {
  Navbar,
  Hero,
  Services,
  TechStack,
  ImpactDashboard,
  ProjectsGrid,
  About,
  ExperienceList,
  Contact,
  Footer,
  CookieConsent
} from "@/components/Islands";
---

<BaseLayout 
  title="Shueny - Senior Frontend Engineer"
  description="Shueny Wang | Senior Frontend Engineer · AI Solutions Builder"
  image={siteConfig.ogImage}
>
  <!-- 
    Islands Architecture for Performance Optimization:
    - Navbar & Hero: client:load (Critical path, hydration needed immediately)
    - Others: client:visible (Hydrate only when scrolled into view)
    - Footer/Cookie: client:idle (Low priority)
  -->
  
  <Navbar client:load />

  <main>
    <Hero client:load />

    <Services client:visible />

    <TechStack client:visible />

    <ImpactDashboard client:visible />

    <ProjectsGrid client:visible />

    <About client:visible />

    <ExperienceList client:visible />

    <Contact client:visible />
  </main>

  <Footer client:idle />

  <CookieConsent client:idle />
</BaseLayout>

