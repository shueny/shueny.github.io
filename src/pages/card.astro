---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ThemeToggle } from "@/components/theme-toggle";
import { Icon } from "astro-icon/components";
import { cardConfig as card } from "@/config/card";

const [firstName, ...restName] = card.name.split(" ");
const lastName = restName.join(" ");
---

<BaseLayout
  title={`${card.name} — Digital Card`}
  description={`${card.title} · ${card.tagline}`}
>
  <main
    class="relative flex min-h-screen items-center justify-center overflow-hidden bg-surface px-5 py-10 text-foreground"
  >
    <!-- Abstract animated background shapes (matches hero) -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div
        class="absolute right-[-15%] top-[-15%] h-[60vw] w-[60vw] animate-pulse-slow rounded-full border border-orange-200/40 opacity-60"
      >
      </div>
      <div
        class="absolute bottom-[-10%] left-[-15%] h-[45vw] w-[45vw] animate-pulse-slow rounded-full bg-orange-100/30 blur-3xl"
        style="animation-delay: 1.5s"
      >
      </div>
    </div>

    <!-- Editorial card: bold type, offset accent shadow -->
    <article
      class="relative z-10 w-full max-w-md animate-fade-in-up border-2 border-primary bg-card p-8 shadow-[10px_10px_0_0_hsl(var(--accent))] transition-shadow duration-300 hover:shadow-[14px_14px_0_0_hsl(var(--accent))] sm:p-10"
    >
      <!-- Top bar: availability + theme toggle -->
      <div
        class="mb-8 flex animate-fade-in-up items-center justify-between"
        style="animation-delay: 0.05s"
      >
        <div class="flex items-center gap-2">
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-accent"></span>
          </span>
          <span class="text-[10px] font-bold uppercase tracking-widest text-accent">
            Open to collaborate
          </span>
        </div>
        <div class="text-foreground">
          <ThemeToggle client:load />
        </div>
      </div>

      <!-- Macro typography name (hero language) -->
      <h1
        class="animate-fade-in-up text-[17vw] font-extrabold leading-[0.9] tracking-tighter sm:text-7xl"
        style="animation-delay: 0.12s"
      >
        <span class="block uppercase">{firstName}</span>
        <span
          class="block bg-gradient-to-r from-accent to-amber-500 bg-clip-text uppercase text-transparent"
        >
          {lastName}
        </span>
      </h1>

      <p
        class="mt-4 animate-fade-in-up font-serif text-xl italic text-primary sm:text-2xl"
        style="animation-delay: 0.2s"
      >
        {card.title.toLowerCase()}
        <span class="not-italic text-accent">*</span>
      </p>

      <p
        class="mt-2 animate-fade-in-up text-xs font-bold uppercase tracking-widest text-muted-foreground"
        style="animation-delay: 0.25s"
      >
        {card.company} — {card.location}
      </p>

      <p
        class="mt-5 animate-fade-in-up border-l-2 border-accent pl-4 text-sm leading-relaxed text-secondary"
        style="animation-delay: 0.3s"
      >
        {card.tagline}
      </p>

      <!-- Index-style action list -->
      <div
        class="mt-8 animate-fade-in-up border-t-2 border-primary"
        style="animation-delay: 0.38s"
      >
        <a
          href="/shueny.vcf"
          download="shueny-wang.vcf"
          class="group flex items-center justify-between border-b-2 border-primary bg-accent px-1 py-4 text-sm font-extrabold uppercase tracking-wider text-white transition-all duration-300 hover:px-3"
        >
          <span class="flex items-center gap-3">
            <span class="font-serif text-xs font-normal italic opacity-80">01</span>
            Save contact
          </span>
          <Icon
            name="lucide:arrow-down-to-line"
            class="size-4 transition-transform duration-300 group-hover:translate-y-0.5"
          />
        </a>
        <a
          href={`mailto:${card.email}`}
          class="group flex items-center justify-between border-b-2 border-primary px-1 py-4 text-sm font-extrabold uppercase tracking-wider transition-all duration-300 hover:bg-accent/10 hover:px-3 hover:text-accent"
        >
          <span class="flex items-center gap-3">
            <span class="font-serif text-xs font-normal italic text-muted-foreground">02</span>
            Email
            <span class="hidden text-[10px] font-medium normal-case tracking-normal text-muted-foreground sm:inline">
              {card.email}
            </span>
          </span>
          <Icon
            name="lucide:arrow-up-right"
            class="size-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
          />
        </a>
        <a
          href={`tel:${card.phone}`}
          class="group flex items-center justify-between border-b-2 border-primary px-1 py-4 text-sm font-extrabold uppercase tracking-wider transition-all duration-300 hover:bg-accent/10 hover:px-3 hover:text-accent"
        >
          <span class="flex items-center gap-3">
            <span class="font-serif text-xs font-normal italic text-muted-foreground">03</span>
            Call
            <span class="hidden text-[10px] font-medium normal-case tracking-normal text-muted-foreground sm:inline">
              {card.phone}
            </span>
          </span>
          <Icon
            name="lucide:arrow-up-right"
            class="size-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
          />
        </a>
      </div>

      <!-- Footer: socials + QR -->
      <div
        class="mt-8 flex animate-fade-in-up items-end justify-between"
        style="animation-delay: 0.46s"
      >
        <div>
          <p class="mb-3 text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
            Elsewhere
          </p>
          <div class="flex gap-2.5">
            {
              card.social.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="grid size-10 place-items-center border-2 border-primary text-foreground transition-all duration-300 hover:-translate-y-1 hover:bg-accent hover:text-white hover:shadow-[3px_3px_0_0_hsl(var(--primary))]"
                >
                  <Icon name={s.icon} class="size-4.5" />
                </a>
              ))
            }
          </div>
          <a
            href="/"
            class="group mt-5 flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest text-muted-foreground transition-colors hover:text-accent"
          >
            Full portfolio
            <Icon
              name="lucide:arrow-right"
              class="size-3 transition-transform duration-300 group-hover:translate-x-1"
            />
          </a>
        </div>

        <div class="text-right">
          <div
            class="inline-block border-2 border-primary bg-white p-2 transition-transform duration-300 hover:rotate-2 hover:scale-105"
          >
            <img
              src="/card-qr.svg"
              alt={`QR code linking to ${card.url}`}
              width="92"
              height="92"
              class="size-[92px]"
              loading="lazy"
            />
          </div>
          <p class="mt-2 text-[9px] font-bold uppercase tracking-widest text-accent">
            Scan me
          </p>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
