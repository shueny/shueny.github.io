---
import BaseLayout from '../layouts/BaseLayout.astro'
import { siteConfig } from '@/config/site'
import HeroStatic from '@/components/HeroStatic.astro'
import NavbarIsland from '@/components/islands/NavbarIsland';
import ServicesIsland from '@/components/islands/ServicesIsland';
import TechStackIsland from '@/components/islands/TechStackIsland';
import ImpactDashboardIsland from '@/components/islands/ImpactDashboardIsland';
import ProjectsGridIsland from '@/components/islands/ProjectsGridIsland';
import WritingSection from '@/components/WritingSection.astro';
import AboutIsland from '@/components/islands/AboutIsland';
import ExperienceListIsland from '@/components/islands/ExperienceListIsland';
import ContactIsland from '@/components/islands/ContactIsland';
import FooterIsland from '@/components/islands/FooterIsland';
import CookieConsentIsland from '@/components/islands/CookieConsentIsland';
---

<BaseLayout 
  title="Shueny - Senior Frontend Engineer"
  description="Shueny Wang | Senior Frontend Engineer. Frontend architecture that scales. AI features that ship."
  image={siteConfig.ogImage}
>
  <!-- 
    Islands Architecture for Performance Optimization:
    - HeroStatic: Pure Astro (no JS needed for FCP)
    - Navbar: client:load (hydration needed for mobile menu)
    - Others: client:visible (Hydrate only when scrolled into view)
    - Footer/Cookie: client:idle (Low priority)
  -->
  
  <NavbarIsland client:load />

  <main>
    <HeroStatic />

    <ServicesIsland client:visible />

    <TechStackIsland client:visible />

    <ImpactDashboardIsland client:visible />

    <ProjectsGridIsland client:visible />

    <WritingSection />

    <AboutIsland client:visible />

    <ExperienceListIsland client:visible />

    <ContactIsland client:visible />
  </main>

  <FooterIsland client:idle />

  <CookieConsentIsland client:idle />
</BaseLayout>

