---
import BlogPostLayout from '@/layouts/blog-post.astro';
import BlogLanguageSwitcher from '@/components/BlogLanguageSwitcher';
import "@/styles/globals.css";
import { getCollection, type CollectionEntry } from 'astro:content';
import { MULTILINGUAL_POSTS } from '@/lib/multilingual-posts';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map((post: CollectionEntry<'blog'>) => ({
        params: { slug: post.slug },
        props: post,
    }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();

const slug = post.slug;
const isMultilingual = MULTILINGUAL_POSTS[slug] !== undefined;

---

<BlogPostLayout {...post.data} slug={post.slug}>
  {isMultilingual ? (
    <BlogLanguageSwitcher client:load slug={slug}>
      <Content />
    </BlogLanguageSwitcher>
  ) : (
    <Content />
  )}
</BlogPostLayout>