---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ThemeToggle } from "@/components/theme-toggle";
import { Icon } from "astro-icon/components";
import { cardConfig as card } from "@/config/card";

const initials = card.name
  .split(" ")
  .map((w) => w[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<BaseLayout
  title={`${card.name} — Digital Card`}
  description={`${card.title} · ${card.tagline}`}
>
  <main
    class="relative flex min-h-screen items-center justify-center bg-background px-5 py-10 text-foreground"
  >
    <!-- Soft accent glow backdrop -->
    <div
      class="pointer-events-none absolute inset-0 overflow-hidden"
      aria-hidden="true"
    >
      <div
        class="absolute left-1/2 top-1/3 h-72 w-72 -translate-x-1/2 rounded-full bg-accent/20 blur-3xl"
      >
      </div>
    </div>

    <article
      class="relative z-10 w-full max-w-sm rounded-3xl border border-border bg-card p-8 shadow-2xl shadow-black/10"
    >
      <!-- Theme toggle -->
      <div class="absolute right-5 top-5 text-foreground">
        <ThemeToggle client:load />
      </div>

      <!-- Avatar -->
      <div
        class="mx-auto mb-4 grid h-24 w-24 place-items-center rounded-full bg-gradient-to-br from-accent to-amber-500 text-3xl font-bold text-white shadow-lg"
      >
        {initials}
      </div>

      <!-- Identity -->
      <h1 class="text-center text-2xl font-bold tracking-tight">{card.name}</h1>
      <p class="mt-1 text-center text-sm font-semibold text-accent">
        {card.title}
      </p>
      <p
        class="mt-1 flex items-center justify-center gap-1.5 text-center text-xs text-muted-foreground"
      >
        <Icon name="lucide:briefcase" class="size-3.5" />
        {card.company}
        <span class="opacity-40">·</span>
        <Icon name="lucide:map-pin" class="size-3.5" />
        {card.location}
      </p>

      <p
        class="mx-2 mt-4 text-center text-sm leading-relaxed text-muted-foreground"
      >
        {card.tagline}
      </p>

      <!-- Primary actions -->
      <div class="mt-6 grid gap-2.5">
        <a
          href="/shueny.vcf"
          download="shueny-wang.vcf"
          class="flex items-center justify-center gap-2 rounded-2xl bg-accent px-4 py-3 text-sm font-semibold text-white transition active:scale-[.98]"
        >
          <Icon name="lucide:user-plus" class="size-4" />
          Save to contacts
        </a>
        <a
          href={`mailto:${card.email}`}
          class="flex items-center justify-center gap-2 rounded-2xl border border-border px-4 py-3 text-sm font-semibold transition hover:border-accent hover:bg-accent/5 active:scale-[.98]"
        >
          <Icon name="lucide:mail" class="size-4" />
          {card.email}
        </a>
        <a
          href={`tel:${card.phone}`}
          class="flex items-center justify-center gap-2 rounded-2xl border border-border px-4 py-3 text-sm font-semibold transition hover:border-accent hover:bg-accent/5 active:scale-[.98]"
        >
          <Icon name="lucide:phone" class="size-4" />
          {card.phone}
        </a>
      </div>

      <!-- Social -->
      <div class="mt-5 flex justify-center gap-3.5">
        {
          card.social.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="grid size-11 place-items-center rounded-full border border-border text-foreground transition hover:border-accent hover:text-accent active:scale-95"
            >
              <Icon name={s.icon} class="size-5" />
            </a>
          ))
        }
      </div>

      <!-- QR code -->
      <div class="mt-6 border-t border-dashed border-border pt-5 text-center">
        <img
          src="/card-qr.svg"
          alt={`QR code linking to ${card.url}`}
          width="128"
          height="128"
          class="mx-auto size-32"
          loading="lazy"
        />
        <p class="mt-2 text-xs text-muted-foreground">Scan to open this card</p>
      </div>

      <!-- Back to portfolio -->
      <a
        href="/"
        class="mt-5 flex items-center justify-center gap-1.5 text-xs font-medium text-muted-foreground transition hover:text-accent"
      >
        View full portfolio
        <Icon name="lucide:arrow-right" class="size-3.5" />
      </a>
    </article>
  </main>
</BaseLayout>
