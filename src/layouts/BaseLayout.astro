---
import '../styles/globals.css'
// Self-hosted fonts: latin subset only (reduces ~28 font files to ~10)
import '@fontsource/outfit/latin-400.css';
import '@fontsource/outfit/latin-500.css';
import '@fontsource/outfit/latin-600.css';
import '@fontsource/outfit/latin-700.css';
import '@fontsource/outfit/latin-800.css';

import '@fontsource/playfair-display/latin-400.css';
import '@fontsource/playfair-display/latin-400-italic.css';
import '@fontsource/playfair-display/latin-700.css';

import { SEO } from "astro-seo";
import { siteConfig } from "@/config/site";

interface Props {
  title?: string
  description?: string
  image?: string
  children?: any
}

const {
  title = "Shueny - Senior Frontend Engineer",
  description = "Shueny Wang | Senior Frontend Engineer · AI Solutions Builder",
  image = siteConfig.ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = image.startsWith("http") 
  ? image 
  : new URL(image, Astro.site).toString();
---

<!DOCTYPE html>
<html lang="zh-TW" class="scroll-smooth snap-y snap-proximity scroll-pt-32">
  <head>
    <!-- Critical Theme Script - prevents FOUC -->
    <script is:inline>
      (function() {
        try {
          var localTheme = localStorage.getItem('theme');
          var supportDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches === true;
          if (!localTheme && supportDarkMode) {
            document.documentElement.classList.add('dark');
          } else if (localTheme === 'dark') {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
    
    <!-- Critical CSS - MUST be first to prevent white flash and improve FCP -->
    <style is:inline>
      /* Critical above-the-fold styles - prevents white flash on page load */
      :root {
        /* Light Mode Variables */
        --background: 0 0% 100%;
        --background-200: 0 0% 98%;
        --foreground: 0 0% 9%;
        --primary: 0 0% 9%;
        --secondary: 30 5% 33%;
        --secondary-foreground: 0 0% 98%;
        --accent: 18 90% 48%;
        
        /* Critical Colors */
        --bg-critical: #fff7ed; /* Warm Cream */
        --text-critical: #1c1917;
      }
      
      .dark {
        /* Dark Mode Variables (from globals.css) */
        --background: 0 0% 4%;
        --background-200: 0 170% 0%;
        --foreground: 0 0% 93%;
        --primary: 0 0% 93%;
        --secondary: 30 5% 50%;
        --secondary-foreground: 0 0% 98%;
        
        /* Critical Colors */
        --bg-critical: #0c0a09; /* Stone 950 */
        --text-critical: #f5f5f5;
      }
      
      html {
        background-color: var(--bg-critical) !important;
        font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      }
      
      body {
        background-color: var(--bg-critical) !important;
        color: var(--text-critical) !important;
        margin: 0 !important;
        padding: 0 !important;
        font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      
      * {
        box-sizing: border-box;
      }

      /* Critical Hero section styles - inlined for faster FCP */
      .bg-surface { background-color: var(--bg-critical); }
    </style>
    
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fff7ed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0a09" media="(prefers-color-scheme: dark)" />
    
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title: "Shueny's Portfolio",
          type: "website",
          image: imageURL,
          url: Astro.url.toString(),
        },
        image: {
          url: imageURL,
          alt: title,
        },
        optional: {
          description: description,
          siteName: siteConfig.name,
          locale: siteConfig.locale || "zh_TW",
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: siteConfig.twitter,
        creator: siteConfig.twitter,
      }}
    />
    <!-- Fonts are self-hosted via @fontsource packages (latin subset only) -->
  </head>
  <body class="text-stone-900 antialiased overflow-x-hidden">
    <slot />
    <style is:global>
      /* Smooth Scrolling & Custom Selection */
      ::selection {
        background-color: #ea580c;
        color: #ffffff;
      }

      body {
        background-color: #fff7ed; /* Warm Cream Background */
        color: #1c1917;
        margin: 0;
      }

      /* Hide scrollbar for cleaner look but keep functionality */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      ::-webkit-scrollbar-thumb {
        background: #fdba74;
        border-radius: 10px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #ea580c;
      }

      .text-outline {
        -webkit-text-stroke: 2px #e7e5e4; /* Stone 200 */
        color: transparent;
      }

      .text-outline-strong {
        -webkit-text-stroke: 2px #d6d3d1;
        color: transparent;
      }

      /* Hide scrollbar for horizontal scroll */
      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }

      /* Ensure container doesn't overflow */
      .container {
        width: 100%;
        margin-left: auto;
        margin-right: auto;
        padding-left: 1.5rem;
        padding-right: 1.5rem;
      }

      @media (min-width: 640px) {
        .container {
          padding-left: 3rem;
          padding-right: 3rem;
        }
      }
    </style>
  </body>
</html>
