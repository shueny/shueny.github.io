---
import MainLayout from "@/layouts/main-layout.astro";

export const prerender = true;

const MANGO = "#DFA900";
const RED = "#F03E2E";

const designNotes = [
  {
    n: "1",
    title: "The calendar hides behind the header date",
    desc: "No new button. The big date users already look at becomes the entry point: tap it and the full month unfolds. Status dots summarize each day (open, overdue, all done), and every day is tappable — empty ones just render dimmer.",
  },
  {
    n: "2",
    title: "The date chip follows the day you are viewing",
    desc: "The add bar carries a date chip whose default is always the card currently in view. Typing on tomorrow's card creates tomorrow's task — no extra tap in the common case. Tapping the chip opens quick picks (today, tomorrow, next Monday) plus a full date picker.",
  },
  {
    n: "3",
    title: "One card per day, swipe to travel",
    desc: "The list is a horizontal rail of day cards built on CSS scroll-snap: zero dependencies, native inertia, days generated on demand. Day pills light up with the scroll position, and leaving today reveals a back-to-today shortcut.",
  },
  {
    n: "4",
    title: "Starting a Pomodoro takes over the whole screen",
    desc: "Press play on a task and a focus overlay covers everything: countdown, progress ring, task name, pause and stop. You cannot scroll the list or add tasks mid-focus. Blocking distraction is the feature, not a limitation.",
  },
];

const decisions = [
  {
    q: "Where do tasks without a date go?",
    a: "They land on today. One simple rule beats a separate 'unscheduled' bucket the user has to remember to check.",
  },
  {
    q: "Do unfinished tasks auto-roll to today?",
    a: "No. They stay on their original day as an honest record, and today's card shows a red prompt to move them over in one tap. The history stays truthful; the fix stays cheap.",
  },
  {
    q: "Due date vs. scheduled date?",
    a: "Merged into a single 'do it on this day' concept. Two date fields on a personal todo item is a data model looking for a problem.",
  },
];

const techStack = ["Vue 3", "Pinia", "CSS Scroll Snap", "PWA"];
---

<MainLayout
  title="Daily Tomato Todo — Design Concept"
  description="A Vue 3 + Pinia daily planner with swipeable day cards, a collapsible calendar, and a full-screen Pomodoro focus timer. Interactive design concept by Shueny."
>
  <!-- Hero -->
  <section class="border-b border-border">
    <div class="container max-w-screen-xl py-16 md:py-20">
      <div class="flex flex-col items-start gap-4">
        <div class="flex items-center gap-3">
          <span class="text-4xl">🍅</span>
          <div>
            <p class="text-3xl font-extrabold leading-none md:text-4xl">Daily Tomato Todo</p>
            <p class="text-lg font-bold text-muted-foreground">
              Vue 3 Daily Planner <span style={`color:${MANGO};`}>+ Pomodoro</span>
            </p>
          </div>
        </div>
        <p class="max-w-2xl text-lg text-muted-foreground">
          A daily planner where the todo list and the focus timer are one
          product, not two features. The phone below is a working mockup —
          swipe the days, open the calendar, and press ▶ on any task.
        </p>
        <div
          class="mt-2 max-w-2xl rounded-2xl border-l-4 p-5"
          style={`border-color:#FFCC22;background:rgba(255,204,34,0.08);`}
        >
          <p class="text-sm font-bold uppercase tracking-wider" style={`color:${MANGO};`}>
            🎯 Design Goal
          </p>
          <p class="mt-2 text-sm text-muted-foreground">
            Make "plan by day" and "focus on one task" the same motion:
            every navigation lands on a day, every task is one tap away from
            a distraction-free Pomodoro.
          </p>
        </div>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          {techStack.map((t) => (
            <span class="rounded-full border border-border bg-card px-3 py-1 text-xs font-semibold">
              {t}
            </span>
          ))}
          <a
            href="https://shueny.github.io/vue-daily-tomato-todo/"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full px-4 py-1 text-xs font-bold text-white"
            style={`background:${MANGO};`}
          >
            Live App ↗
          </a>
          <a
            href="https://github.com/shueny/vue-daily-tomato-todo"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border px-4 py-1 text-xs font-bold"
            style={`border-color:${MANGO};color:${MANGO};`}
          >
            GitHub Repo
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive demo + design notes -->
  <section class="border-b border-border" style={`background:linear-gradient(180deg, rgba(255,204,34,0.06), transparent);`}>
    <div class="container max-w-screen-xl grid grid-cols-1 items-start gap-12 py-16 lg:grid-cols-2">
      <div>
        <h2 class="mb-2 text-sm font-bold uppercase tracking-wider" style={`color:${MANGO};`}>
          Interactive Design Concept
        </h2>
        <h3 class="text-3xl font-extrabold md:text-4xl">Try the mockup</h3>
        <p class="mt-3 text-muted-foreground">
          Four decisions carry the whole design. Each one removes a tap or
          removes a distraction.
        </p>

        <ol class="mt-6 space-y-5">
          {designNotes.map((note) => (
            <li class="flex gap-3">
              <span
                class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white"
                style={`background:${MANGO};`}
              >
                {note.n}
              </span>
              <div>
                <p class="text-sm font-bold">{note.title}</p>
                <p class="mt-1 text-sm text-muted-foreground">{note.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="lg:sticky lg:top-24 flex justify-center">
        <!-- ══ interactive phone mockup (vanilla JS, self-contained) ══ -->
        <div class="dtt">
          <div class="phone" id="dttPhone">
            <div class="app-head">
              <div class="date-row" id="dateRow" role="button" tabindex="0" aria-expanded="false" aria-label="Open calendar">
                <span class="big" id="hBig">06</span>
                <span class="ym"><b id="hY">2026</b><br /><span id="hM">Jul</span></span>
                <span class="caret">▼</span>
                <span class="wk" id="hWk">Mon</span>
              </div>
              <div class="hint-cal">Tap the date to open the calendar 📅</div>

              <div class="addbar">
                <input placeholder="+ Add task" aria-label="Add task" />
                <button class="chip-date" id="chipDate" aria-haspopup="true">📅 <span id="chipTxt">Today</span></button>
                <button class="btn-plus" aria-label="Add">+</button>
              </div>

              <div class="pop" id="pop">
                <button data-q="today">Today</button>
                <button data-q="tomorrow">Tomorrow</button>
                <button data-q="nextweek">Next Monday</button>
                <div class="sep"></div>
                <label>or pick a date…<br /><input type="date" value="2026-07-06" class="pop-date" /></label>
              </div>
            </div>

            <!-- collapsible calendar -->
            <div class="cal" id="cal">
              <div class="cal-inner">
                <div class="cal-grid" id="calGrid"></div>
              </div>
            </div>

            <div class="body-area">
              <div class="pomo" id="pomo">
                <div class="pomo-modes">
                  <button class="pm on" data-m="25">25/5</button>
                  <button class="pm" data-m="50">50/10</button>
                </div>
                <div class="pomo-idle" id="pomoIdle">Press ▶ on a task to focus</div>
              </div>

              <div class="daynav" id="dayNav">
                <button class="pill" data-i="1">Yesterday</button>
                <button class="pill on" data-i="2">Today</button>
                <button class="pill" data-i="3">Tomorrow</button>
                <button class="today-btn" id="backToday">Back to today ↩</button>
              </div>

              <div class="rail" id="rail"></div>
              <div class="swipe-hint">← Swipe, tap a pill, or pick any day in the calendar →</div>
            </div>

            <!-- focus overlay -->
            <div class="focus" id="focus" role="dialog" aria-label="Focusing">
              <div class="phase">🍅 Focus</div>
              <div class="ringwrap">
                <svg width="210" height="210" viewBox="0 0 210 210" aria-hidden="true">
                  <circle class="ring-bg" cx="105" cy="105" r="96" fill="none" stroke-width="7"></circle>
                  <circle class="ring-fg" id="ringFg" cx="105" cy="105" r="96" fill="none" stroke-width="7" stroke-linecap="round"></circle>
                </svg>
                <div class="t" id="focusTime">25:00</div>
              </div>
              <div class="task" id="focusTask">Task name</div>
              <div class="paused-tag" id="pausedTag">Paused</div>
              <div class="ctrl">
                <button class="btn-toggle" id="focusToggle" aria-label="Pause / resume">⏸</button>
                <button class="btn-stop" id="focusStop" aria-label="Stop">■</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product decisions -->
  <section class="container max-w-screen-xl py-16">
    <h2 class="mb-8 text-sm font-bold uppercase tracking-wider" style={`color:${MANGO};`}>
      Product Decisions
    </h2>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {decisions.map((d) => (
        <div class="rounded-2xl border border-border bg-card p-6">
          <h3 class="text-sm font-bold">{d.q}</h3>
          <p class="mt-2 text-sm text-muted-foreground">{d.a}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Attribution -->
  <section class="border-t border-border">
    <div class="container max-w-screen-xl py-16">
      <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-extrabold md:text-4xl">Why rebuild a todo app?</h2>
          <p class="mt-4 text-muted-foreground">
            This started years ago as my first Vue learning project. Rebuilding
            it with Vue 3 and Pinia was a deliberate exercise in restraint:
            the day carousel ships with zero dependencies, the whole app state
            lives in one store, and the boldest feature is the one that removes
            options instead of adding them. Small product, real product
            thinking.
          </p>
        </div>
        <div class="rounded-3xl border border-border bg-card p-8">
          <p class="text-sm font-bold uppercase tracking-wider text-muted-foreground">Built by</p>
          <p class="mt-1 text-2xl font-extrabold">Shueny Wang</p>
          <p class="mt-1 text-muted-foreground">Product designer &amp; front-end engineer</p>
          <p class="mt-4 text-sm text-muted-foreground">
            Designed and built end-to-end: interaction concept, visual system,
            state architecture and implementation.
          </p>
          <a
            href="https://shueny.github.io/vue-daily-tomato-todo/"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-block rounded-2xl px-5 py-3 text-sm font-bold text-white"
            style={`background:${MANGO};`}
          >
            Open the live app →
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<!-- Mockup styles: global on purpose (the demo builds DOM at runtime, so
     Astro's scoped-style attributes would never reach it). Everything is
     namespaced under .dtt to avoid leaking into the site. -->
<style is:global>
  .dtt{
    --mango:#FFCC22; --mango-deep:#DFA900; --mango-soft:#FFF3CC;
    --ink:#4a4a4a; --ink-soft:#9d9689;
    --ground:#F7F4EC; --card:#FFFFFF; --line:#EDE7D8;
    --red:#FF3F3F; --green:#00A916;
    --shadow:0 10px 30px rgba(120,95,10,.14);
    line-height:1.6;
    font-family:"Nunito","Noto Sans TC",system-ui,-apple-system,sans-serif;
  }
  html.dark .dtt{
    --mango:#FFCC22; --mango-deep:#FFD84D; --mango-soft:#3A3211;
    --ink:#F0EAD8; --ink-soft:#A69D87;
    --ground:#1D1A12; --card:#292418; --line:#3A3424;
    --red:#FF6B6B; --green:#4CC964; --shadow:0 10px 30px rgba(0,0,0,.5);
  }
  .dtt *{box-sizing:border-box}

  .dtt .phone{
    width:375px;max-width:100%;
    background:var(--card);border-radius:26px;box-shadow:var(--shadow);
    overflow:hidden;border:1px solid var(--line);
    user-select:none;position:relative;color:var(--ink);
  }

  /* focus overlay */
  .dtt .focus{
    position:absolute;inset:0;z-index:50;display:none;
    flex-direction:column;align-items:center;justify-content:center;gap:1.1rem;
    background:rgba(60,58,52,.55);
    -webkit-backdrop-filter:blur(10px) saturate(.85);
    backdrop-filter:blur(10px) saturate(.85);
    color:#fff;text-align:center;padding:2rem 1.5rem;
  }
  @supports not (backdrop-filter: blur(1px)){
    .dtt .focus{background:rgba(55,53,48,.85)}
  }
  .dtt .focus.show{display:flex}
  .dtt .focus .phase{font-size:.8rem;font-weight:800;letter-spacing:.25em;color:#FFCC22;text-transform:uppercase;text-shadow:0 1px 3px rgba(0,0,0,.35)}
  .dtt .focus .ringwrap{position:relative;width:210px;height:210px}
  .dtt .focus svg{transform:rotate(-90deg)}
  .dtt .focus .ring-bg{stroke:rgba(255,255,255,.25)}
  .dtt .focus .ring-fg{stroke:#FFCC22;transition:stroke-dashoffset 1s linear;filter:drop-shadow(0 1px 3px rgba(0,0,0,.3))}
  .dtt .focus .t{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    font-size:2.9rem;font-weight:800;font-variant-numeric:tabular-nums;color:#fff;
    text-shadow:0 2px 8px rgba(0,0,0,.45);
  }
  .dtt .focus .task{font-size:1rem;font-weight:700;color:#fff;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-shadow:0 1px 4px rgba(0,0,0,.4)}
  .dtt .focus .paused-tag{font-size:.72rem;color:rgba(255,255,255,.75);visibility:hidden}
  .dtt .focus .paused-tag.show{visibility:visible}
  .dtt .focus .ctrl{display:flex;gap:1.4rem;margin-top:.4rem}
  .dtt .focus .ctrl button{
    width:56px;height:56px;border-radius:50%;font-size:1.25rem;cursor:pointer;font-family:inherit;
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 3px 10px rgba(0,0,0,.25);
  }
  .dtt .focus .btn-toggle{background:#FFCC22;border:0;color:#3d3012}
  .dtt .focus .btn-stop{background:rgba(255,255,255,.85);border:2px solid #FF6B6B;color:#FF3F3F}
  .dtt .focus .ctrl button:focus-visible{outline:2px solid #fff;outline-offset:3px}

  /* header */
  .dtt .app-head{background:var(--mango);padding:16px 18px 14px;color:#4a4a1e;position:relative}
  .dtt .date-row{display:flex;align-items:flex-start;gap:8px;cursor:pointer;-webkit-tap-highlight-color:transparent}
  .dtt .date-row .big{font-size:2.1rem;font-weight:800;line-height:1;color:#453d10}
  .dtt .date-row .ym{font-size:.7rem;font-weight:700;line-height:1.25;color:#5c5316;padding-top:2px}
  .dtt .date-row .caret{font-size:.7rem;color:#5c5316;padding-top:8px;transition:transform .25s}
  .dtt .date-row.open .caret{transform:rotate(180deg)}
  .dtt .date-row .wk{margin-left:auto;font-size:1.35rem;font-weight:700;color:#453d10}
  .dtt .hint-cal{font-size:.68rem;color:#6b6120;margin-top:2px}

  /* add bar */
  .dtt .addbar{display:flex;align-items:center;background:#fff;border-radius:2rem;margin-top:12px;padding:6px 6px 6px 16px;gap:8px;box-shadow:0 2px 6px rgba(90,70,0,.12)}
  html.dark .dtt .addbar{background:#3a3424}
  .dtt .addbar input{border:0;outline:0;flex:1;font:inherit;font-size:.9rem;color:var(--ink);background:transparent;min-width:0}
  .dtt .addbar input::placeholder{color:var(--ink-soft)}
  .dtt .chip-date{
    display:flex;align-items:center;gap:4px;flex:0 0 auto;
    background:var(--mango-soft);color:var(--mango-deep);
    font-size:.74rem;font-weight:800;border:0;border-radius:2rem;padding:6px 11px;cursor:pointer;font-family:inherit;
  }
  .dtt .chip-date:focus-visible,.dtt .date-row:focus-visible{outline:2px solid #453d10;outline-offset:2px}
  .dtt .btn-plus{flex:0 0 34px;height:34px;border-radius:50%;background:var(--mango);border:2px solid #fff;color:#fff;font-size:1.25rem;line-height:1;font-weight:700;cursor:pointer}
  html.dark .dtt .btn-plus{border-color:#292418}

  /* date popover */
  .dtt .pop{
    position:absolute;right:14px;top:108px;z-index:30;
    background:var(--card);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);
    padding:8px;display:none;flex-direction:column;gap:2px;width:180px;
  }
  .dtt .pop.show{display:flex}
  .dtt .pop button{
    font:inherit;font-size:.85rem;text-align:left;border:0;background:none;color:var(--ink);
    padding:8px 10px;border-radius:8px;cursor:pointer;
  }
  .dtt .pop button:hover{background:var(--mango-soft)}
  .dtt .pop .sep{height:1px;background:var(--line);margin:4px 6px}
  .dtt .pop label{font-size:.72rem;color:var(--ink-soft);padding:2px 10px 6px;display:block}
  .dtt .pop .pop-date{font:inherit;font-size:.8rem;margin-top:2px;border:1px solid var(--line);border-radius:6px;padding:2px 6px;background:var(--card);color:var(--ink)}

  /* calendar */
  .dtt .cal{max-height:0;overflow:hidden;transition:max-height .3s ease;background:var(--mango)}
  .dtt .cal.open{max-height:320px}
  .dtt .cal-inner{padding:4px 14px 14px}
  .dtt .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;text-align:center}
  .dtt .cal-grid .dow{font-size:.62rem;font-weight:800;color:#6b6120;padding:4px 0}
  .dtt .cal-cell{
    position:relative;border:0;background:none;font:inherit;font-size:.8rem;font-weight:700;color:#574d14;
    padding:7px 0 11px;border-radius:10px;cursor:pointer;
  }
  .dtt .cal-cell:hover{background:rgba(255,255,255,.35)}
  .dtt .cal-cell.dim{opacity:.55}
  .dtt .cal-cell.today{outline:2px solid #fff;outline-offset:-2px}
  .dtt .cal-cell.sel{background:#fff;color:var(--mango-deep)}
  .dtt .cal-cell .dots{position:absolute;left:0;right:0;bottom:4px;display:flex;gap:3px;justify-content:center}
  .dtt .cal-cell .dot{width:4.5px;height:4.5px;border-radius:50%;background:#8a7a1e}
  .dtt .cal-cell .dot.red{background:var(--red)}
  .dtt .cal-cell .dot.grn{background:#1b7d2c}
  .dtt .cal-cell.sel .dot{background:var(--mango-deep)}

  /* body */
  .dtt .body-area{background:var(--card)}
  .dtt .pomo{display:flex;align-items:center;gap:8px;padding:12px 14px 0}
  .dtt .pomo-modes{display:inline-flex;border:1.5px solid var(--mango);border-radius:2rem;overflow:hidden}
  .dtt .pomo .pm{font:inherit;font-size:.74rem;font-weight:800;border:0;background:none;color:var(--mango-deep);padding:4px 12px;cursor:pointer}
  .dtt .pomo .pm.on{background:var(--mango);color:#fff}
  .dtt .pomo-idle{font-size:.7rem;color:var(--ink-soft);margin-left:auto}
  .dtt .a-play{font:inherit;border:0;background:none;cursor:pointer;color:var(--ink-soft);font-size:.8rem;padding:0}
  .dtt .daynav{display:flex;align-items:center;gap:6px;padding:12px 14px 2px}
  .dtt .daynav .pill{
    font:inherit;font-size:.74rem;font-weight:800;border:1.5px solid var(--line);
    background:none;color:var(--ink-soft);border-radius:2rem;padding:4px 12px;cursor:pointer;
  }
  .dtt .daynav .pill.on{background:var(--mango);border-color:var(--mango);color:#fff}
  .dtt .daynav .today-btn{margin-left:auto;font-size:.72rem;font-weight:800;color:var(--mango-deep);background:none;border:0;cursor:pointer;font-family:inherit;visibility:hidden}
  .dtt .daynav .today-btn.show{visibility:visible}

  .dtt .rail{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
  .dtt .rail::-webkit-scrollbar{display:none}
  .dtt .card-day{flex:0 0 100%;scroll-snap-align:center;padding:10px 16px 18px;min-height:275px}
  .dtt .card-day h3{font-size:.78rem;color:var(--ink-soft);font-weight:800;margin:.2rem 0 .6rem;letter-spacing:.06em}
  .dtt .rollover{
    display:flex;align-items:center;gap:6px;font-size:.74rem;font-weight:700;color:var(--red);
    background:color-mix(in srgb, var(--red) 9%, transparent);
    border-radius:10px;padding:7px 11px;margin-bottom:10px;cursor:pointer;
  }
  .dtt .todo{display:flex;align-items:flex-start;gap:10px;padding:9px 0;border-bottom:1px solid var(--line)}
  .dtt .todo:last-child{border-bottom:0}
  .dtt .box{flex:0 0 20px;height:20px;border-radius:6px;background:var(--line);margin-top:2px;position:relative;cursor:pointer}
  .dtt .todo.done .box{background:var(--mango)}
  .dtt .todo.done .box::after{content:"";position:absolute;left:6px;top:2.5px;width:6px;height:10px;border:solid #fff;border-width:0 2.5px 2.5px 0;transform:rotate(45deg)}
  .dtt .todo .tx{flex:1;min-width:0}
  .dtt .todo .tt{font-size:.9rem;font-weight:700;color:var(--ink)}
  .dtt .todo.done .tt{text-decoration:line-through;color:var(--ink-soft)}
  .dtt .todo .meta{font-size:.7rem;color:var(--ink-soft);display:flex;gap:10px;flex-wrap:wrap}
  .dtt .todo .meta .late{color:var(--red);font-weight:800}
  .dtt .todo .acts{display:flex;gap:8px;color:var(--ink-soft);font-size:.8rem;opacity:.75;padding-top:3px}
  .dtt .todo .acts .star{color:var(--mango)}
  .dtt .empty{color:var(--ink-soft);font-size:.82rem;text-align:center;padding:56px 0}
  .dtt .empty b{display:block;font-size:1.6rem;margin-bottom:6px}
  .dtt .swipe-hint{text-align:center;font-size:.7rem;color:var(--ink-soft);padding:6px 0 14px}

  @media (prefers-reduced-motion: reduce){
    .dtt .cal,.dtt .date-row .caret{transition:none}
    .dtt .rail{scroll-behavior:auto !important}
    .dtt .focus .ring-fg{transition:none}
  }
</style>

<script is:inline>
(function(){
  // demo data: July 2026, one card per day
  var TODOS = {
    '2026-07-03': [{t:'Tidy the room',done:true}],
    '2026-07-04': [{t:'Laundry',done:true},{t:'Run 5k',done:true,star:true}],
    '2026-07-05': [{t:'Buy carrots',done:false,late:true,c:2},{t:'Reply to emails',done:true}],
    '2026-07-06': [{t:'Cold brew coffee',done:true,star:true},{t:'Weekly project report',done:false,tom:2},{t:'Buy milk',done:false}],
    '2026-07-07': [{t:'Dentist 14:00',done:false},{t:'Buy birthday gift',done:false,star:true}],
    '2026-07-08': [{t:'Pay electricity bill',done:false}],
    '2026-07-15': [{t:'Haircut',done:false}],
    '2026-07-28': [{t:'Credit card bill',done:false}]
  };
  var WEEK = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  var DAYS = [];
  for(var day=1; day<=31; day++){
    var d = '2026-07-'+String(day).padStart(2,'0');
    var dt = new Date(d+'T00:00:00');
    var prefix = '';
    if(day===5) prefix='Yesterday · '; if(day===6) prefix='Today · '; if(day===7) prefix='Tomorrow · ';
    DAYS.push({d:d, label: prefix+'7/'+day+' '+WEEK[dt.getDay()], todos: TODOS[d]||[], roll: day===6?1:0});
  }
  var TODAY_I = 5; // 7/6

  var rail = document.getElementById('rail');
  if(!rail) return;

  DAYS.forEach(function(dayItem){
    var c = document.createElement('div');
    c.className='card-day';
    var h = '<h3>'+dayItem.label+'</h3>';
    if(dayItem.roll) h += '<div class="rollover">⚠ '+dayItem.roll+' unfinished from yesterday — tap to move to today</div>';
    if(dayItem.todos.length===0) h += '<div class="empty"><b>🌤</b>No tasks this day<br>Add one in the bar above</div>';
    dayItem.todos.forEach(function(td){
      h += '<div class="todo'+(td.done?' done':'')+'">'
        +'<span class="box"></span>'
        +'<span class="tx"><span class="tt">'+td.t+'</span>'
        +'<span class="meta">'
        +(td.late?'<span class="late">Overdue</span>':'')
        +(td.c?'<span>💬 '+td.c+'</span>':'')
        +(td.tom?'<span>🍅 '+td.tom+'</span>':'')
        +'</span></span>'
        +'<span class="acts"><button class="a-play" data-t="'+td.t+'">▶</button> ✎ 🗑 <span class="'+(td.star?'star':'')+'">★</span></span>'
        +'</div>';
    });
    c.innerHTML = h;
    rail.appendChild(c);
  });

  var active = TODAY_I;
  function fmtHeader(i){
    var d = new Date(DAYS[i].d+'T00:00:00');
    document.getElementById('hBig').textContent = String(d.getDate()).padStart(2,'0');
    document.getElementById('hM').textContent = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()];
    document.getElementById('hWk').textContent = WEEK[d.getDay()];
  }
  function chipLabel(i){
    var diff = i - TODAY_I;
    var names = {0:'Today',1:'Tomorrow','-1':'Yesterday'};
    return names[diff] || '7/'+(i+1);
  }
  function setActive(i, scroll){
    active = i;
    fmtHeader(i);
    document.getElementById('chipTxt').textContent = chipLabel(i);
    document.querySelectorAll('#dayNav .pill').forEach(function(p){
      p.classList.toggle('on', (TODAY_I-2 + +p.dataset.i) === i);
    });
    document.getElementById('backToday').classList.toggle('show', i!==TODAY_I);
    document.querySelectorAll('.dtt .cal-cell').forEach(function(cell){
      cell.classList.toggle('sel', cell.dataset.d===DAYS[i].d);
    });
    if(scroll) rail.scrollTo({left: rail.clientWidth*i, behavior:'smooth'});
  }

  rail.addEventListener('scroll', function(){
    var i = Math.round(rail.scrollLeft / rail.clientWidth);
    if(i!==active && DAYS[i]) setActive(i,false);
  }, {passive:true});

  document.querySelectorAll('#dayNav .pill').forEach(function(p){
    p.addEventListener('click', function(){ setActive(TODAY_I-2 + +p.dataset.i, true); });
  });
  document.getElementById('backToday').addEventListener('click', function(){ setActive(TODAY_I,true); });

  // calendar: every day tappable
  var grid = document.getElementById('calGrid');
  ['S','M','T','W','T','F','S'].forEach(function(w){
    var el=document.createElement('span'); el.className='dow'; el.textContent=w; grid.appendChild(el);
  });
  // July 2026: 7/1 is Wednesday
  for(var b=0;b<3;b++){ var sp=document.createElement('span'); grid.appendChild(sp); }
  DAYS.forEach(function(dayData, idx){
    var cell=document.createElement('button');
    cell.className='cal-cell'; cell.dataset.d=dayData.d; cell.textContent=idx+1;
    cell.setAttribute('aria-label','July '+(idx+1));
    if(!dayData.todos.length) cell.classList.add('dim');
    if(dayData.d==='2026-07-06') cell.classList.add('today');
    if(dayData.todos.length){
      var wrap=document.createElement('span'); wrap.className='dots';
      var anyOpen = dayData.todos.some(function(t){return !t.done;});
      var anyLate = dayData.todos.some(function(t){return t.late&&!t.done;});
      var dot=document.createElement('span');
      dot.className='dot'+(anyLate?' red':(anyOpen?'':' grn'));
      wrap.appendChild(dot);
      if(dayData.todos.length>2){var d2=document.createElement('span');d2.className='dot';wrap.appendChild(d2);}
      cell.appendChild(wrap);
    }
    cell.addEventListener('click', function(){ setActive(idx,true); toggleCal(false); });
    grid.appendChild(cell);
  });

  var cal = document.getElementById('cal');
  var dateRow = document.getElementById('dateRow');
  function toggleCal(force){
    var open = force!==undefined ? force : !cal.classList.contains('open');
    cal.classList.toggle('open', open);
    dateRow.classList.toggle('open', open);
    dateRow.setAttribute('aria-expanded', open);
  }
  dateRow.addEventListener('click', function(){ toggleCal(); });
  dateRow.addEventListener('keydown', function(e){ if(e.key==='Enter'||e.key===' '){e.preventDefault();toggleCal();} });

  // date chip popover
  var pop = document.getElementById('pop');
  document.getElementById('chipDate').addEventListener('click', function(e){
    e.stopPropagation(); pop.classList.toggle('show');
  });
  pop.addEventListener('click', function(e){
    var q = e.target.dataset && e.target.dataset.q;
    if(q==='today') setActive(TODAY_I,true);
    if(q==='tomorrow') setActive(TODAY_I+1,true);
    if(q==='nextweek') setActive(TODAY_I+7,true);
    if(q) pop.classList.remove('show');
    e.stopPropagation();
  });
  document.addEventListener('click', function(){ pop.classList.remove('show'); });

  // pomodoro: full-screen focus overlay
  var focusEl = document.getElementById('focus');
  var ringFg = document.getElementById('ringFg');
  var CIRC = 2*Math.PI*96;
  ringFg.style.strokeDasharray = CIRC;
  var pomoMode = 25, pomoLeft = 0, pomoTotal = 0, pomoTimer = null, paused = false;
  function fmt(s){ return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0'); }
  function paint(){
    document.getElementById('focusTime').textContent = fmt(Math.max(0,pomoLeft));
    ringFg.style.strokeDashoffset = CIRC * (1 - pomoLeft/pomoTotal);
  }
  function tickStart(){
    clearInterval(pomoTimer);
    pomoTimer = setInterval(function(){
      pomoLeft--; paint();
      if(pomoLeft<=0) stopPomo();
    },1000);
  }
  function stopPomo(){
    clearInterval(pomoTimer); pomoTimer=null; paused=false;
    focusEl.classList.remove('show');
  }
  function setPaused(v){
    paused = v;
    document.getElementById('focusToggle').textContent = paused ? '▶' : '⏸';
    document.getElementById('pausedTag').classList.toggle('show', paused);
    if(paused) clearInterval(pomoTimer); else tickStart();
  }
  document.querySelectorAll('.dtt .pomo .pm').forEach(function(btn){
    btn.addEventListener('click', function(){
      pomoMode = +btn.dataset.m;
      document.querySelectorAll('.dtt .pomo .pm').forEach(function(x){ x.classList.toggle('on', x===btn); });
    });
  });
  document.querySelectorAll('.dtt .a-play').forEach(function(btn){
    btn.addEventListener('click', function(){
      pomoLeft = pomoTotal = pomoMode*60;
      document.getElementById('focusTask').textContent = btn.dataset.t;
      setPaused(false);
      paint();
      focusEl.classList.add('show');
      tickStart();
    });
  });
  document.getElementById('focusToggle').addEventListener('click', function(){ setPaused(!paused); });
  document.getElementById('focusStop').addEventListener('click', stopPomo);

  // init position
  setActive(TODAY_I,false);
  requestAnimationFrame(function(){ rail.scrollLeft = rail.clientWidth*TODAY_I; });
})();
</script>
