---
import { siteConfig } from "@/config/site";
import "@/styles/globals.css";
import { ViewTransitions } from "astro:transitions";
import { SEO } from "astro-seo";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  nofollow?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description = siteConfig.description,
  image = siteConfig.ogImage,
  type = "website",
  publishedTime,
  modifiedTime,
  author = siteConfig.author || siteConfig.name,
  tags = [],
  noindex = false,
  nofollow = false,
} = Astro.props;

// Construct full image URL
const imageURL = image.startsWith("http") 
  ? image 
  : new URL(image, Astro.site).toString();

// Default title for homepage
const defaultTitle = "Shueny - Senior Frontend Engineer";
const pageTitle = title 
  ? title.includes("Shueny") || title.includes(siteConfig.name)
    ? title
    : `${title} | ${siteConfig.name}`
  : defaultTitle;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="https://shueny.github.io/favicon.png" />
<link rel="icon" type="image/x-icon" href="https://shueny.github.io/favicon.ico" />
<!-- SVG favicon -->
<link rel="icon" type="image/svg+xml" href="https://shueny.github.io/favicon.svg" />
  
<!-- PNG favicons -->
<link rel="icon" type="image/png" sizes="32x32" href="https://shueny.github.io/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="https://shueny.github.io/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="https://shueny.github.io/apple-touch-icon.png" />
<link rel="manifest" href="https://shueny.github.io/site.webmanifest" />
<meta name="generator" content={Astro.generator} />

<!-- Preconnect to Google Fonts for faster loading (early DNS resolution) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- DNS prefetch for font CDN -->
<link rel="dns-prefetch" href="https://fonts.gstatic.com" />

<!-- Font preloads for critical fonts -->
<link
  rel="preload"
  href="/fonts/calsans-semibold.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<!-- Resource hints for critical path optimization -->
<link rel="dns-prefetch" href="https://shueny.github.io" />

<!-- Load Google Fonts asynchronously to avoid render-blocking -->
<!-- Using improved async loading with fallback -->
<link
  rel="preload"
  href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Noto+Sans+TC:wght@400;500;700&display=swap"
  as="style"
  onload="this.onload=null;this.rel='stylesheet'"
/>
<noscript>
  <link
    href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Noto+Sans+TC:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
</noscript>
<!-- Fallback for browsers that don't support onload on link tags -->
<script is:inline>
  (function() {
    var link = document.querySelector('link[rel="preload"][as="style"][href*="fonts.googleapis.com"]');
    if (link && !link.onload) {
      var fallback = document.createElement('link');
      fallback.rel = 'stylesheet';
      fallback.href = link.href;
      document.head.appendChild(fallback);
    }
  })();
</script>

<!-- SEO Component -->
<SEO
  title={pageTitle}
  description={description}
  canonical={canonicalURL.toString()}
  openGraph={{
    basic: {
      title: title || "Shueny's Portfolio",
      type: type,
      image: imageURL,
      url: Astro.url.toString(),
    },
    image: {
      url: imageURL,
      alt: title || siteConfig.name,
    },
    optional: {
      description: description,
      siteName: siteConfig.name,
      locale: siteConfig.locale || "zh_TW",
      ...(publishedTime && { publishedTime }),
      ...(modifiedTime && { modifiedTime }),
      ...(author && { author }),
      ...(tags.length > 0 && { tags }),
    },
  }}
  twitter={{
    card: "summary_large_image",
    site: siteConfig.twitter,
    creator: siteConfig.twitter,
  }}
  extend={{
    link: [
      {
        rel: "canonical",
        href: canonicalURL.toString(),
      },
    ],
    meta: [
      {
        name: "author",
        content: author,
      },
      {
        name: "google-site-verification",
        content: "XJZuarIE-FwHruVx1m1r9e96aPCtrRbzphkkUU0-G1I",
      },
      ...(noindex ? [{ name: "robots", content: "noindex" }] : []),
      ...(nofollow ? [{ name: "robots", content: "nofollow" }] : []),
    ],
  }}
/>

<!-- Dark mode with prevent flickering flash between navigations -->
<script is:inline>
const setDarkMode = () => {
  const theme = (() => {
    if (
      typeof localStorage !== "undefined" &&
      localStorage.getItem("theme")
    ) {
      return localStorage.getItem("theme");
    }
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      return "dark";
    }
    return "light";
  })();

  if (theme === "light") {
    document.documentElement.classList.remove("dark");
  } else {
    document.documentElement.classList.add("dark");
  }
  window.localStorage.setItem("theme", theme);
};

setDarkMode();
document.addEventListener("astro:after-swap", setDarkMode);
</script>

<!-- Register Service Worker for better caching on GitHub Pages -->
<script is:inline>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js')
        .then((registration) => {
          console.log('Service Worker registered:', registration.scope);
        })
        .catch((error) => {
          console.log('Service Worker registration failed:', error);
        });
    });
  }
</script>

<ViewTransitions />
