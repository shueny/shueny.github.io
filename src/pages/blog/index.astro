---
import { getPosts } from "@/lib/fetchers";
import Navbar from "@/components/Navbar";
import Footer from "@/components/Footer";
import "@/styles/globals.css";

// 1. 取得所有文章
const allPosts = await getPosts();

// 2. 應用 Draft 過濾邏輯
const posts = allPosts.filter((post) => {
  // 如果是生產環境 (Build/Production)，且文章標記為 draft，則過濾掉 (回傳 false)
  if (import.meta.env.PROD && post.data.draft) {
    return false;
  }
  // 其他情況 (開發環境 或 非 draft) 則保留
  return true;
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Blog | Shueny</title>
  </head>
  
  <body class="bg-surface text-custom-primary font-sans antialiased selection:bg-orange-100 selection:text-custom-accent">
    
    <Navbar client:load />

    <main class="pt-32 pb-24 min-h-screen container mx-auto px-6 md:px-12">
      {/* 頁面標題區塊 */}
      <div class="max-w-3xl mb-16 animate-fade-in-up">
        <span class="text-custom-accent font-bold tracking-widest text-xs uppercase mb-3 block">
          Engineering & Insights
        </span>
        <h1 class="text-4xl md:text-6xl font-serif font-bold text-custom-primary mb-6">
          Writing
        </h1>
        <p class="text-custom-secondary text-lg font-light leading-relaxed max-w-xl">
          Thoughts on frontend architecture, AI integration, and building scalable systems.
        </p>
      </div>

      {/* 文章列表 Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 border-t border-custom-muted/40 pt-12 animate-fade-in-up delay-100">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group flex flex-col h-full relative">
            
            {/* 🛠️ 開發模式提示：如果是 Draft，在卡片上顯示標籤方便識別 */}
            {post.data.draft && (
              <span class="absolute top-2 right-2 z-10 bg-yellow-400 text-stone-900 text-[10px] font-bold px-2 py-1 rounded shadow-sm">
                DRAFT
              </span>
            )}

            {/* 圖片區塊 */}
            {post.data.cover && (
              <div class="aspect-[16/10] overflow-hidden rounded-lg mb-6 bg-stone-100 shadow-sm border border-stone-100/50">
                <img 
                  src={post.data.cover} 
                  alt={post.data.title} 
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
                />
              </div>
            )}
            
            {/* 文字資訊 */}
            <div class="flex flex-col flex-grow">
              <div class="flex items-center gap-3 mb-3 text-xs font-medium uppercase tracking-wider text-custom-secondary/60">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
                {post.data.category && (
                  <>
                    <span class="w-1 h-1 rounded-full bg-custom-accent/60"></span>
                    <span class="text-custom-accent">{post.data.category}</span>
                  </>
                )}
              </div>
              
              <h2 class="text-2xl font-serif font-bold text-custom-primary mb-3 group-hover:text-custom-accent transition-colors leading-tight">
                {post.data.title}
              </h2>
              
              {post.data.description && (
                <p class="text-custom-secondary font-light leading-relaxed line-clamp-3 text-sm">
                  {post.data.description}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>
    </main>

    <Footer client:visible />
  </body>
</html>