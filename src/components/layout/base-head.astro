---
import { siteConfig } from "@/config/site";
import "@/styles/globals.css";
import { ViewTransitions } from "astro:transitions";
import { SEO } from "astro-seo";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  nofollow?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description = siteConfig.description,
  image = siteConfig.ogImage,
  type = "website",
  publishedTime,
  modifiedTime,
  author = siteConfig.author || siteConfig.name,
  tags = [],
  noindex = false,
  nofollow = false,
} = Astro.props;

// Construct full image URL
const imageURL = image.startsWith("http") 
  ? image 
  : new URL(image, Astro.site).toString();

// Default title for homepage
const defaultTitle = "Shueny - Senior Frontend Engineer";
const pageTitle = title 
  ? title.includes("Shueny") || title.includes(siteConfig.name)
    ? title
    : `${title} | ${siteConfig.name}`
  : defaultTitle;
---

<!-- Critical CSS - MUST be first to prevent white flash and improve FCP -->
<!-- This inline style ensures background color is applied immediately, before any external CSS loads -->
<style is:inline>
  /* Critical above-the-fold styles - prevents white flash on page load */
  html {
    background-color: #fff7ed !important; /* Warm Cream Background - matches body */
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  }
  
  body {
    background-color: #fff7ed !important; /* Warm Cream Background */
    color: #1c1917 !important;
    margin: 0 !important;
    padding: 0 !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, 'Nunito', 'Noto Sans TC', sans-serif;
    font-size-adjust: 0.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  
  /* Prevent layout shift during font loading */
  * {
    box-sizing: border-box;
  }
  
  /* Ensure text is visible immediately with proper contrast */
  h1, h2, h3, h4, h5, h6, p, span, a, div {
    color: #1c1917;
  }
  
  /* Prevent invisible text during font load */
  .fonts-loading {
    visibility: visible !important; /* Keep content visible */
  }
</style>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="https://shueny.github.io/favicon.png" />
<link rel="icon" type="image/x-icon" href="https://shueny.github.io/favicon.ico" />
<!-- SVG favicon -->
<link rel="icon" type="image/svg+xml" href="https://shueny.github.io/favicon.svg" />
  
<!-- PNG favicons -->
<link rel="icon" type="image/png" sizes="32x32" href="https://shueny.github.io/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="https://shueny.github.io/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="https://shueny.github.io/apple-touch-icon.png" />
<link rel="manifest" href="https://shueny.github.io/site.webmanifest" />
<meta name="generator" content={Astro.generator} />

<!-- Preconnect to Google Fonts for faster loading (early DNS resolution) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- DNS prefetch for font CDN -->
<link rel="dns-prefetch" href="https://fonts.gstatic.com" />

<!-- Font preloads for critical fonts -->
<link
  rel="preload"
  href="/fonts/calsans-semibold.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<!-- Resource hints for critical path optimization -->
<link rel="dns-prefetch" href="https://shueny.github.io" />

<!-- Load Google Fonts with font-display=swap to reduce CLS -->
<!-- Using improved async loading with fallback -->
<link
  rel="preload"
  href="https://fonts.googleapis.com/css2?family=Nunito:wght@200;300;400;500;600;700;800;900&family=Noto+Sans+TC:wght@100;300;400;500;700;900&display=swap"
  as="style"
  onload="this.onload=null;this.rel='stylesheet'"
/>
<noscript>
  <link
    href="https://fonts.googleapis.com/css2?family=Nunito:wght@200;300;400;500;600;700;800;900&family=Noto+Sans+TC:wght@100;300;400;500;700;900&display=swap"
    rel="stylesheet"
  />
</noscript>
<!-- Fallback for browsers that don't support onload on link tags -->
<script is:inline>
  (function() {
    var link = document.querySelector('link[rel="preload"][as="style"][href*="fonts.googleapis.com"]');
    if (link && !link.onload) {
      var fallback = document.createElement('link');
      fallback.rel = 'stylesheet';
      fallback.href = link.href;
      document.head.appendChild(fallback);
    }
  })();
</script>
<!-- Additional font loading optimizations (non-critical, can load after FCP) -->
<style is:inline>
  /* Font loading optimization - prevent CLS */
  /* These styles complement the critical CSS above */
  .fonts-loaded {
    visibility: visible;
  }
</style>
<script is:inline>
  // Font loading detection to prevent CLS
  (function() {
    if ('fonts' in document) {
      Promise.all([
        document.fonts.load('400 1em Nunito'),
        document.fonts.load('400 1em "Noto Sans TC"')
      ]).then(function() {
        document.documentElement.classList.add('fonts-loaded');
        document.documentElement.classList.remove('fonts-loading');
      });
    } else {
      // Fallback for browsers without Font Loading API
      document.documentElement.classList.add('fonts-loaded');
    }
  })();
</script>

<!-- SEO Component -->
<SEO
  title={pageTitle}
  description={description}
  canonical={canonicalURL.toString()}
  openGraph={{
    basic: {
      title: title || "Shueny's Portfolio",
      type: type,
      image: imageURL,
      url: Astro.url.toString(),
    },
    image: {
      url: imageURL,
      alt: title || siteConfig.name,
    },
    optional: {
      description: description,
      siteName: siteConfig.name,
      locale: siteConfig.locale || "zh_TW",
      ...(publishedTime && { publishedTime }),
      ...(modifiedTime && { modifiedTime }),
      ...(author && { author }),
      ...(tags.length > 0 && { tags }),
    },
  }}
  twitter={{
    card: "summary_large_image",
    site: siteConfig.twitter,
    creator: siteConfig.twitter,
  }}
  extend={{
    link: [
      {
        rel: "canonical",
        href: canonicalURL.toString(),
      },
    ],
    meta: [
      {
        name: "author",
        content: author,
      },
      {
        name: "google-site-verification",
        content: "XJZuarIE-FwHruVx1m1r9e96aPCtrRbzphkkUU0-G1I",
      },
      ...(noindex ? [{ name: "robots", content: "noindex" }] : []),
      ...(nofollow ? [{ name: "robots", content: "nofollow" }] : []),
    ],
  }}
/>

<!-- Dark mode with prevent flickering flash between navigations -->
<script is:inline>
const setDarkMode = () => {
  const theme = (() => {
    if (
      typeof localStorage !== "undefined" &&
      localStorage.getItem("theme")
    ) {
      return localStorage.getItem("theme");
    }
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      return "dark";
    }
    return "light";
  })();

  if (theme === "light") {
    document.documentElement.classList.remove("dark");
  } else {
    document.documentElement.classList.add("dark");
  }
  window.localStorage.setItem("theme", theme);
};

setDarkMode();
document.addEventListener("astro:after-swap", setDarkMode);
</script>

<!-- Register Service Worker early for better caching on GitHub Pages -->
<script is:inline>
  if ('serviceWorker' in navigator) {
    // Register immediately, don't wait for load event
    // This allows Service Worker to start caching earlier
    navigator.serviceWorker.register('/sw.js', { scope: '/' })
      .then((registration) => {
        console.log('Service Worker registered:', registration.scope);
        // Update Service Worker if a new version is available
        registration.addEventListener('updatefound', () => {
          const newWorker = registration.installing;
          if (newWorker) {
            newWorker.addEventListener('statechange', () => {
              if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                // New Service Worker available, reload to use it
                console.log('New Service Worker available');
              }
            });
          }
        });
      })
      .catch((error) => {
        console.log('Service Worker registration failed:', error);
      });
  }
</script>

<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-T8S9M00FCN" is:inline></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-T8S9M00FCN', { send_page_view: false });

  // Track page views on ViewTransitions navigation
  document.addEventListener('astro:page-load', function() {
    gtag('event', 'page_view', {
      page_title: document.title,
      page_location: window.location.href,
      page_path: window.location.pathname,
    });
  });
</script>

<ViewTransitions />
