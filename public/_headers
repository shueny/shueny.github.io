# Cache headers for static assets
# This file is used by Netlify. For GitHub Pages, consider using a service worker or CDN configuration.

# Cache JavaScript and CSS files for 1 year (with content-based hashing)
/_astro/*.js
  Cache-Control: public, max-age=31536000, immutable

/_astro/*.css
  Cache-Control: public, max-age=31536000, immutable

# Cache font files for 1 year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images for 1 year
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Cache other static assets
/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# HTML files - shorter cache (1 hour) to allow for updates
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Default cache for other files
/*
  Cache-Control: public, max-age=86400

