---
import MainLayout from "@/layouts/main-layout.astro";
import LuckyDuckIsland from "@/components/islands/LuckyDuckIsland";
import WireframeSection from "@/components/LuckyDuck/WireframeSection.jsx";
import ProjectQA from "@/components/LuckyDuck/ProjectQA.jsx";

export const prerender = true;

const PURPLE = "#6C3CFF";
const YELLOW = "#FFD600";

const coreLoops = [
  { icon: "👥", title: "Acquisition Loop", desc: "Users discover Lucky Duck, sign up, and complete their wallet set up." },
  { icon: "🚀", title: "Activation Loop", desc: "Users get credits, explore rewards, and understand the value." },
  { icon: "🎁", title: "Engagement Loop", desc: "Users play, collect, unlock deals, and build their reward portfolio." },
  { icon: "👑", title: "Retention Loop", desc: "Users return for new deals, achievements, and better odds." },
];

const mvpScope = [
  "User Signup & Wallet Setup",
  "Credit Purchase & Management",
  "Reward Discovery & Deals",
  "Portfolio & Collections",
  "Tier System & Progress",
  "Achievements & Notifications",
  "Mobile-first Responsive Web App",
  "Analytics & Event Tracking",
];

const screens = [
  { tag: "Acquisition", title: "Landing", desc: "A bold, mascot-led hero that sells the core promise in one line." },
  { tag: "Activation", title: "Signup / Wallet", desc: "Low-friction account creation that opens a credit wallet instantly." },
  { tag: "Engagement", title: "Reward Discovery", desc: "Featured deals, categories and trending picks ready to claim." },
  { tag: "Retention", title: "Portfolio", desc: "Balance, collections and recent wins in one glanceable view." },
  { tag: "Delight", title: "Celebration", desc: "Confetti + mascot moment that makes every win feel earned." },
];

const keyFeatures = [
  { icon: "🪙", title: "Credit System", desc: "Users purchase credits and use them to unlock rewards." },
  { icon: "🎯", title: "Reward Deals", desc: "Browse, filter, and discover exclusive rewards and deals." },
  { icon: "🗂️", title: "Collections", desc: "Users collect rewards and complete themed collections." },
  { icon: "🏅", title: "Achievements", desc: "Milestones and badges drive motivation and retention." },
  { icon: "📈", title: "Tiers & Progress", desc: "Level up and unlock better odds and exclusive benefits." },
  { icon: "🔔", title: "Notifications", desc: "Real-time updates on deals, wins, and achievements." },
  { icon: "🎲", title: "Odds Engine", desc: "Transparent odds for each reward to build trust and excitement." },
  { icon: "📱", title: "Mobile-First", desc: "Optimized experience across all mobile devices." },
];

const expectedImpact = [
  { icon: "👥", title: "Higher Acquisition", desc: "Frictionless signup and clear value prop." },
  { icon: "🚀", title: "Better Activation", desc: "Quick wallet setup + bonus credits." },
  { icon: "🎁", title: "Stronger Engagement", desc: "Collections, achievements, and rewards." },
  { icon: "👑", title: "Long-Term Retention", desc: "Tiers, exclusive deals, and personalized offers." },
];

const palette = [
  { name: "Primary Yellow", hex: "#FFD600" },
  { name: "Duck Yellow", hex: "#FFE88A" },
  { name: "Deep Purple", hex: "#6C3CFF" },
  { name: "Success Green", hex: "#22C55E" },
  { name: "Surface", hex: "#1A1A22" },
  { name: "Text Dark", hex: "#1A1A1A" },
];

const valueTags = ["Fun", "Trustworthy", "Rewarding", "Transparent"];

const techStack = ["Astro", "React", "TypeScript", "Tailwind CSS", "Framer Motion"];
---

<MainLayout
  title="Lucky Duck — Interactive MVP Concept"
  description="A clickable, mobile-first prototype for the Lucky Duck consumer rewards platform — designed and front-end engineered by Shueny."
>
  <!-- Hero -->
  <section class="border-b border-border">
    <div class="container max-w-screen-xl py-16 md:py-20">
      <div class="flex flex-col items-start gap-4">
        <div class="flex items-center gap-3">
          <span class="text-4xl">🦆</span>
          <div>
            <p class="text-3xl font-extrabold leading-none md:text-4xl">Lucky Duck</p>
            <p class="text-lg font-bold text-muted-foreground">
              Rewards Platform <span style={`color:${YELLOW};`}>MVP</span>
            </p>
          </div>
        </div>
        <p class="max-w-2xl text-lg text-muted-foreground">
          Turn everyday spending into exciting rewards. This is a working,
          clickable concept — designed <em>and</em> built front-to-back in the
          same stack the product would ship on.
        </p>
        <div
          class="mt-2 max-w-2xl rounded-2xl border-l-4 p-5"
          style={`border-color:${YELLOW};background:rgba(255,214,0,0.06);`}
        >
          <p class="text-sm font-bold uppercase tracking-wider" style={`color:${YELLOW};`}>
            🎯 MVP Goal
          </p>
          <p class="mt-2 text-sm text-muted-foreground">
            Build the core acquisition → activation → engagement → retention
            loops that drive user growth, habit formation, and reward redemption.
          </p>
        </div>
        <div class="mt-2 flex flex-wrap gap-2">
          {techStack.map((t) => (
            <span class="rounded-full border border-border bg-card px-3 py-1 text-xs font-semibold">
              {t}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Core loops + MVP scope -->
  <section class="container max-w-screen-xl py-14">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="mb-5 text-sm font-bold uppercase tracking-wider" style={`color:${PURPLE};`}>
          Core Loops
        </h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {coreLoops.map((l, i) => (
            <div class="rounded-2xl border border-border bg-card p-5 transition hover:-translate-y-1 hover:shadow-lg">
              <div
                class="flex h-12 w-12 items-center justify-center rounded-full text-xl"
                style={`background:rgba(108,60,255,0.12);`}
              >
                {l.icon}
              </div>
              <h3 class="mt-3 text-base font-bold">{i + 1}. {l.title}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{l.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h2 class="mb-5 text-sm font-bold uppercase tracking-wider" style={`color:${PURPLE};`}>
          MVP Scope
        </h2>
        <ul class="space-y-3">
          {mvpScope.map((item) => (
            <li class="flex items-center gap-3 text-sm">
              <span
                class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[11px] text-white"
                style={`background:${PURPLE};`}
              >
                ✓
              </span>
              <span class="font-medium">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Interactive demo -->
  <section class="border-y border-border" style={`background:linear-gradient(180deg, rgba(108,60,255,0.05), transparent);`}>
    <div class="container max-w-screen-xl grid grid-cols-1 items-start gap-12 py-16 lg:grid-cols-2">
      <div>
        <h2 class="mb-2 text-sm font-bold uppercase tracking-wider" style={`color:${PURPLE};`}>
          Mobile Screens (Primary MVP Flow)
        </h2>
        <h3 class="text-3xl font-extrabold md:text-4xl">Try the prototype</h3>
        <p class="mt-3 text-muted-foreground">
          The primary happy flow, fully interactive. Create an account, discover
          a deal, claim your reward, and watch it land in your portfolio. Toggle
          the site theme to see the light and dark design systems.
        </p>

        <ol class="mt-6 space-y-3">
          {screens.map((s, i) => (
            <li class="flex gap-3">
              <span
                class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-bold"
                style={`background:${YELLOW};color:#15151C;`}
              >
                {i + 1}
              </span>
              <div>
                <span class="text-xs font-bold uppercase tracking-wide" style={`color:${PURPLE};`}>
                  {s.tag}
                </span>
                <p class="text-sm font-bold">{s.title}</p>
                <p class="text-sm text-muted-foreground">{s.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="lg:sticky lg:top-24">
        <LuckyDuckIsland client:only="react" />
      </div>
    </div>
  </section>

  <!-- Screen architecture & wireframes -->
  <section class="container max-w-screen-xl py-12">
    <div class="overflow-hidden rounded-3xl border border-border shadow-sm" style="background:#ffffff;color:#0A0A0A;">
      <WireframeSection client:visible />
    </div>
  </section>

  <!-- Key MVP features -->
  <section class="container max-w-screen-xl py-16">
    <h2 class="mb-8 text-sm font-bold uppercase tracking-wider" style={`color:${PURPLE};`}>
      Key MVP Features
    </h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {keyFeatures.map((f) => (
        <div>
          <div
            class="flex h-11 w-11 items-center justify-center rounded-full text-lg"
            style={`background:rgba(108,60,255,0.12);`}
          >
            {f.icon}
          </div>
          <h3 class="mt-3 text-sm font-bold">{f.title}</h3>
          <p class="mt-1 text-xs leading-relaxed text-muted-foreground">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Design system -->
  <section class="border-y border-border bg-card/40">
    <div class="container max-w-screen-xl py-16">
      <h2 class="mb-8 text-sm font-bold uppercase tracking-wider" style={`color:${PURPLE};`}>
        Design System (Foundation)
      </h2>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-border bg-card p-6">
          <h3 class="mb-4 text-xs font-bold uppercase tracking-wider text-muted-foreground">Colors</h3>
          <div class="grid grid-cols-3 gap-3">
            {palette.map((c) => (
              <div>
                <div class="h-12 w-full rounded-xl border border-border" style={`background:${c.hex};`}></div>
                <p class="mt-1 text-[11px] font-semibold">{c.name}</p>
                <p class="text-[10px] text-muted-foreground">{c.hex}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-2xl border border-border bg-card p-6">
          <h3 class="mb-4 text-xs font-bold uppercase tracking-wider text-muted-foreground">Typography</h3>
          <p class="text-4xl font-extrabold leading-none">Aa</p>
          <p class="mt-2 text-base font-bold">Bold / Semibold / Medium / Regular</p>
          <p class="mt-1 text-sm text-muted-foreground">
            Clean, modern, and highly legible.
          </p>
        </div>

        <div class="rounded-2xl border border-border bg-card p-6">
          <h3 class="mb-4 text-xs font-bold uppercase tracking-wider text-muted-foreground">Components</h3>
          <div class="space-y-3">
            <button class="w-full rounded-2xl py-2.5 text-sm font-bold" style={`background:${YELLOW};color:#15151C;`}>Get Started</button>
            <div class="flex gap-2">
              <span class="rounded-full px-3 py-1 text-xs font-bold" style={`background:${YELLOW};color:#15151C;`}>🪙 Credits</span>
              <span class="rounded-full border border-border px-3 py-1 text-xs font-bold">🏆 Tier 3</span>
            </div>
            <div class="h-2 w-full overflow-hidden rounded-full bg-muted">
              <div class="h-full w-2/3 rounded-full" style={`background:${YELLOW};`}></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Expected impact -->
  <section class="container max-w-screen-xl py-16">
    <h2 class="mb-8 text-sm font-bold uppercase tracking-wider" style={`color:${PURPLE};`}>
      Expected Impact
    </h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {expectedImpact.map((e) => (
        <div class="text-center sm:text-left">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-full text-xl"
            style={`background:rgba(255,214,0,0.14);`}
          >
            {e.icon}
          </div>
          <h3 class="mt-3 text-base font-bold">{e.title}</h3>
          <p class="mt-1 text-sm text-muted-foreground">{e.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Proposal Q&A (client brief answers) -->
  <section class="container max-w-screen-xl pb-12">
    <div class="overflow-hidden rounded-3xl border border-border shadow-sm" style="background:#ffffff;color:#0A0A0A;">
      <ProjectQA client:visible />
    </div>
  </section>

  <!-- Why + attribution -->
  <section class="border-t border-border">
    <div class="container max-w-screen-xl py-16">
      <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-extrabold md:text-4xl">Why Lucky Duck?</h2>
          <p class="mt-4 text-muted-foreground">
            We combine the excitement of gaming, the value of rewards, and the
            trust of transparency to create a habit-forming experience users
            love. Every screen maps to a growth loop — acquisition → activation
            → engagement → retention — so product design works as a growth
            function, not just a coat of paint.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            {valueTags.map((tag) => (
              <span
                class="rounded-full px-3 py-1 text-xs font-bold"
                style={`background:rgba(108,60,255,0.12);color:${PURPLE};`}
              >
                {tag}
              </span>
            ))}
          </div>
          <img
            src="/images/duck-coin.png"
            alt="Lucky Duck mascot holding a star coin"
            width="160"
            height="160"
            loading="lazy"
            class="mt-6 h-40 w-auto"
            onerror="this.remove()"
          />
        </div>
        <div class="rounded-3xl border border-border bg-card p-8">
          <p class="text-sm font-bold uppercase tracking-wider text-muted-foreground">Built by</p>
          <p class="mt-1 text-2xl font-extrabold">Shueny Wang</p>
          <p class="mt-1 text-muted-foreground">Product designer & front-end engineer</p>
          <p class="mt-4 text-sm text-muted-foreground">
            Designed the system and built the front end end-to-end, so handoff to
            a backend engineer for payments, credits and the odds engine is clean
            and ready.
          </p>
          <a
            href="/portfolio"
            class="mt-6 inline-block rounded-2xl px-5 py-3 text-sm font-bold"
            style={`background:${YELLOW};color:#15151C;`}
          >
            See more work →
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
